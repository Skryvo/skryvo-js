{
  "name": "skryvo",
  "version": "0.1.0",
  "description": "Skryvo for Node.js and the command line: write, design and schedule posts and articles in a brand's voice.",
  "keywords": [
    "skryvo",
    "social media",
    "scheduling",
    "content",
    "ai writing",
    "sdk",
    "cli",
    "api"
  ],
  "homepage": "https://skryvo.ai/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skryvo/skryvo-js.git"
  },
  "bugs": {
    "url": "https://github.com/Skryvo/skryvo-js/issues"
  },
  "license": "MIT",
  "author": "Flutter Studio LLC <support@skryvo.ai>",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "skryvo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsup",
    "typecheck": "tsc -p .",
    "test": "npm run build && node --test test/sdk.test.mjs test/cli.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
